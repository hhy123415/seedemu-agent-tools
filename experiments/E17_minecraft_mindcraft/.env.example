# OpenAI-compatible chat endpoint only. Never commit real keys.
OPENAI_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Embeddings are disabled; examples and skills use local keyword matching.
# Optional upstream code generation for custom actions/building.
MINDCRAFT_ALLOW_CODING=false
